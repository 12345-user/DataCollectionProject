# Shared env/config for Step 02-07 pipeline

# Root Python runtime (created in project root)
PYTHON_RUNTIME=.venv\Scripts\python.exe

# Step 02 / paperscraper
PAPERSCRAPER_SERVER_DUMP_DIR=server_dumps

# Step 03 / GROBID
GROBID_HOST=http://localhost:8070
GROBID_PROCESS_ENDPOINT=/api/processFulltextDocument

# Step 04 / WhoIsWho + GLiNER
WHOISWHO_MODEL_DIR=shared\models\whoiswho
GLINER_MODEL_NAME=urchade/gliner_medium-v2.1

# Step 05 / KeyBERT
KEYBERT_SENTENCE_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Step 06 / Embedding + clustering
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
HDBSCAN_MIN_CLUSTER_SIZE=3
HDBSCAN_MIN_SAMPLES=1
UMAP_N_NEIGHBORS=15
UMAP_MIN_DIST=0.1

# Step 07 / Temporal analysis
TEMPORAL_TAU_DAYS=365
TEMPORAL_RECENT_WINDOW_DAYS=365
TEMPORAL_PAST_WINDOW_DAYS=365
